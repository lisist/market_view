{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Welcome to MkDocs","text":"<p>For full documentation visit mkdocs.org.</p>"},{"location":"#commands","title":"Commands","text":"<ul> <li><code>mkdocs new [dir-name]</code> - Create a new project.</li> <li><code>mkdocs serve</code> - Start the live-reloading docs server.</li> <li><code>mkdocs build</code> - Build the documentation site.</li> <li><code>mkdocs -h</code> - Print help message and exit.</li> </ul>"},{"location":"#project-layout","title":"Project layout","text":"<pre><code>mkdocs.yml    # The configuration file.\ndocs/\n    index.md  # The documentation homepage.\n    ...       # Other markdown pages, images and other files.\n</code></pre>"},{"location":"Canada/business/","title":"Business","text":""},{"location":"Canada/employment/","title":"Employment","text":"<ul> <li> <p>\uce90\ub098\ub2e4 \uc2e4\uc5c5\ub960 \uc790\uccb4\ub294 \ud558\ub77d\ud558\uace0 \uc788\uc74c. \uace0\uc810\uc740 25\ub144 8\uc6d4\uc758 7.1%</p> </li> <li> <p>\uadf8\ub7ec\ub098 \uace0\uc6a9 \uc778\uc6d0\uc758 \ubcc0\ud654\ub294 26\ub144 1\uc6d4 \uc74c\uc218\ub85c \ub3cc\uc544\uc11c\uace0 \uc788\uc5b4 \uace0\uc6a9 \ud658\uacbd\uc758 \uac1c\uc120\uc774 \uc774\ub8e8\uc5b4\uc9c0\uace0 \uc788\ub294\uc9c0\uc5d0 \ub300\ud55c \ud3c9\uac00\ub294 \uc720\ubcf4</p> </li> </ul>"},{"location":"Canada/inflation/","title":"Inflation","text":""},{"location":"Market%20Sentiments/securities/","title":"Securities","text":""},{"location":"Market%20Sentiments/sentiment/","title":"Sentiment","text":""},{"location":"US/business/","title":"Business","text":""},{"location":"US/business/#_1","title":"\ube44\uc988\ub2c8\uc2a4 \ud658\uacbd \uc11c\ubca0\uc774","text":"<ul> <li>ISM \uc11c\ubca0\uc774 \uacb0\uacfc\uc0c1 \ubbf8 \uae30\uc5c5\ub4e4\uc758 \ud65c\ub3d9 \uc804\ub9dd\uc740 \uc591\ud638. \ucd5c\uadfc \ubc18\ub4f1\uc138\ub97c \ubcf4\uc5ec\uc90c</li> </ul> <ul> <li>\uc18c\uae30\uc5c5 \ub099\uad00 \uc9c0\uc218\ub3c4 \uc591\ud638</li> </ul>"},{"location":"US/business/#business-outlook","title":"\uc9c0\uc5ed \uc5f0\uc900 Business Outlook","text":""},{"location":"US/business/#durable-goods-order","title":"Durable Goods Order","text":""},{"location":"US/consumption/","title":"Consumption","text":""},{"location":"US/consumption/#consumer-confidence","title":"Consumer Confidence","text":""},{"location":"US/consumption/#consumer-credit","title":"Consumer Credit","text":""},{"location":"US/consumption/#housing-activities","title":"Housing Activities","text":""},{"location":"US/employment/","title":"Employment","text":"<ul> <li> <p>\ubbf8 \uace0\uc6a9 \uc0c1\ud669 \uc545\ud654\uc138 \uc9c0\uc18d\ub418\uace0 \uc788\ub2e4\uace0 \ud310\ub2e8. \uc2e4\uc5c5\ub960\uc740 \uc0c1\uc2b9 \ucd94\uc138\uc5d0 \ub193\uc5ec \uc788\uace0 \uc18c\ube44\uc790\ub4e4\uc758 \uace0\uc6a9\uc5d0 \ub300\ud55c \uc790\uc2e0\uac10\uc740 \uac08\uc218\ub85d \ud1f4\uc0c9\ub418\uc5b4\uac00\uace0 \uc788\uc74c</p> </li> <li> <p>Low Hiring, Low Firing \uc0c1\ud669\uc774 \uc9c0\uc18d\ub418\uace0 \uc788\uc5b4 \uace0\uc6a9 \uc2dc\uc7a5\uc758 \uade0\ud615\uc774 \uac04\uc2e0\ud788 \uc720\uc9c0\ub418\uace0 \uc788\uc73c\ub098 \uacbd\uc81c\uc758 \uc57d\uac04\uc758 \ubd80\uc815\uc801\uc778 \ucda9\uaca9\uc73c\ub85c\ub3c4 \uc2e4\uc5c5\ub960\uc774 \ud655\ub300\ub420 \uc704\ud5d8\uc774 \uc788\uc5b4 \ubcf4\uc784</p> </li> </ul> <ul> <li> <p>26\ub144 1\uc6d4 NFP\ub294 130k \uc99d\uac00\ud558\uba70 \uae0d\uc815\uc801\uc778 \ubaa8\uc2b5. \uadf8\ub7ec\ub098 25\ub144 1\uc6d4\uc5d0\ub3c4 100k \ub118\uac8c NFP \uac00 \uc0c1\uc2b9\ud588\uc73c\ub098 \uc774\ud6c4 revision \ub418\uc5c8\ub358 \uac83\uc744 \uc0dd\uac01\ud558\uba74 \uc774\ud6c4\uc758 \ubaa8\uc2b5\uc744 \ubcf4\uc544\uc57c \uc804\ubc18\uc801\uc778 \uace0\uc6a9 \uc2dc\uc7a5 \ud3c9\uac00\uac00 \uac00\ub2a5\ud560 \uac83\uc73c\ub85c \ubcf4\uc784</p> </li> <li> <p>ADP\ub294 \ubc18\ub300\ub85c 1\uc6d4\uc5d0\ub3c4 \uace0\uc6a9 \uc2dc\uc7a5\uc774 \ub454\ud654\ub418\uace0 \uc788\uc74c\uc744 \uc2dc\uc0ac</p> </li> </ul> <ul> <li> <p>26\ub144 1\uc6d4 Job leaver(\uc790\ubc1c\uc801 \ud1f4\uc0ac) rate\uac00 \ud070 \ud3ed \uc0c1\uc2b9. \ubcf4\ud1b5 \uacbd\uae30 \uc0c1\ud669\uc774 \uc88b\uc744 \ub54c \uc790\ubc1c\uc801 \ud1f4\uc0ac\uac00 \ub298\uc5b4\ub098\ub294 \uacbd\ud5a5</p> </li> <li> <p>\ubc18\uba74 \uc815\uaddc\uc9c1\uc5d0\uc11c \ud574\uace0 \ub2f9\ud55c \ube44\uc911\uc740 \uc774\uc804\uacfc \ube44\uc2b7\ud55c \uc218\uc900\uc744 \uc720\uc9c0\ud558\uace0 \uc788\uc74c</p> </li> </ul> <ul> <li> <p>Indeed\uc758 Job posting\uacfc JOLTS\uc758 Job opening Rate\uac00 \ub2e4\ub978 \uc2e0\ud638\ub97c \ubcf4\ub0b4\uace0 \uc788\uc74c. 1\uc6d4 Job opening Rate\uc758 \uae09\ub77d\uc740 \uc2dc\uc7a5\uc758 \uc6b0\ub824\ub97c \ubd80\ub984</p> </li> <li> <p>\ubbf8\uad6d \ud574\uace0 \uac74\uc218\uc758 \uae09\uc99d\uc740 \uad00\ucc30\ub418\uace0 \uc788\uc9c0 \uc54a\uc74c. \uc790\ubc1c\uc801\uc778 \ud1f4\uc0ac\ub3c4 \ub0ae\uc740 \uc218\uc900\uc73c\ub85c \uc720\uc9c0\ub418\uace0 \uc788\uc74c. \uacbd\uc9c1\uc801\uc778 \uace0\uc6a9 \ud658\uacbd</p> </li> <li> <p>25\ub144 \uc774\ud6c4 \ud574\uace0 \ubc1c\ud45c\ub294 \uc99d\uac00. 26\ub144 1\uc6d4 \ud574\uace0 \ubc1c\ud45c \uac74\uc218\ub294 09\ub144 \uc774\ud6c4 \ucd5c\uace0 \uc218\uc900</p> </li> </ul> <ul> <li> <p>ISM \uc81c\uc870\uc5c5\uc5d0\uc11c \uace0\uc6a9 \uad00\ub828 \uac1c\uc120 \uc9c0\ud45c \ud655\uc778. \uadf8\ub7ec\ub098 \uc800\uc810\uc5d0\uc11c \ubc18\ub4f1\ud588\uc744 \ubfd0\uc774\uace0 \uc544\uc9c1 48.1\ub85c \uc218\ucd95 \uad6d\uba74\uc744 \uc720\uc9c0\ud558\uace0 \uc788\uc5b4\uc11c \uace0\uc6a9 \uc2dc\uc7a5\uc758 \uc804\ubc18\uc801\uc778 \ubc18\ub4f1\uc744 \uc774\uc57c\uae30\ud558\uae30\uc5d0\ub294 \ubd80\uc871\ud568</p> </li> <li> <p>ISM \uc11c\ube44\uc2a4 \ubd80\ubb38\uc758 \uace0\uc6a9\uc740 \uc591\ud638\ud55c \uc0c1\ud669\uc73c\ub85c \ubcf4\uc774\ub098 50\uc744 \uaca8\uc6b0 \ub118\uace0 \uc788\uace0 \uc0c1\uc2b9 \ucd94\uc138\uac00 \uaebe\uc778 \ubaa8\uc591\uc0c8</p> </li> </ul>"},{"location":"US/inflation/","title":"Inflation","text":"<ul> <li> <p>CPI \uc9c0\ud45c\uc0c1 \uc778\ud50c\ub808\uc774\uc158 \uc9c4\uc815 \ucd94\uc138 \uc774\uc5b4\uc9c0\uace0 \uc788\uc74c</p> </li> <li> <p>Shelter price\ub97c \uc81c\uc678\ud55c \uc11c\ube44\uc2a4 \uc778\ud50c\ub808\uc774\uc158 \ucd5c\uadfc \uc0c1\uc2b9\ud558\uace0 \uc788\uc74c</p> </li> </ul> <ul> <li>ISM \uc11c\ubca0\uc774\uc5d0 \ub530\ub974\uba74 \uae30\uc5c5\ub4e4\uc774 \uc608\uc0c1\ud558\uace0 \uc788\ub294 \uac00\uaca9 \uc555\ub825\uc740 2025\ub144 \uc774\ud6c4 \ub2e4\uc18c \uac10\uc18c\ud558\uae34 \ud588\uc73c\ub098 \uc0c1\uc2b9 \ucd94\uc138\ub294 \uc5ec\uc804\ud568</li> </ul> <ul> <li>\ubc18\uba74 Truflation \uc2e4\uc2dc\uac04 \uc790\ub8cc\ub97c \ubcf4\uba74 \uc778\ud50c\ub808\uc774\uc158 \uc9c4\uc815\ub418\uace0 \uc788\uc5b4 \ubcf4\uc784. \uc55e\uc11c ISM \uc11c\ubca0\uc774 \uc9c0\ud45c\uc640\ub294 \ubc18\ub300\ub418\ub294 \uc0c1\ud669</li> </ul> <ul> <li> <p>\uc9c4\uc815\ub418\uc5b4\uac00\ub294 \uc9c0\ud45c\uc640\ub294 \ub2e4\ub974\uac8c \uc18c\ube44\uc790\ub4e4\uc758 \uc778\ud50c\ub808\uc774\uc158 \uae30\ub300 \uc218\uc900\uc740 \uc0c1\uc2b9\ud55c \uc774\ud6c4 \uc774\uc804 \uc218\uc900\uc73c\ub85c \ud68c\ubcf5\ub418\uc9c0 \uc54a\uace0 \uc788\uc74c. \uc774\ub294 \uc5f0\uc900\uc5d0 \ub300\ud55c \uacbd\uace0 \uc2e0\ud638\uc784</p> </li> <li> <p>\ubbf8\uc2dc\uac04 \uc18c\ube44\uc790 \uc2e0\ub8b0\uc9c0\uc218 \ub0b4 \ub2e8\uae30 \uc778\ud50c\ub808\uc774\uc158 \uae30\ub300\uce58\ub294 \uc9c4\uc815\ub418\uace0 \uc788\uc74c. \uc18c\ube44\uc790\ub4e4\uc740 \ud070 \uad00\uc138 \uc601\ud5a5\uc774 \uc9c0\ub098\uac14\ub2e4\uace0 \ud310\ub2e8\ud558\uace0 \uc788\uc74c</p> </li> </ul> <ul> <li>\uc774\ub780 \uc804\uc7c1 \uc774\ud6c4 \uc720\uac00 \uc0c1\uc2b9\uc73c\ub85c \uc778\ud574 \uc778\ud50c\ub808\uc774\uc158 \uae30\ub300\uac10 \uc0c1\uc2b9\ud558\ub294 \ubaa8\uc2b5</li> </ul>"},{"location":"theme/iran/","title":"Iran","text":""},{"location":"theme/iran/#summary","title":"\ud638\ub974\ubb34\uc988 \ud574\ud611 \uae34\uc7a5 Summary","text":"<pre><code>- \uc774\ub780\uacfc \ud2b8\ub7fc\ud504 \ubaa8\ub450 \uc2dc\uac04\uc774 \uc9c0\ub0a0 \uc218\ub85d \uc555\ubc15\uc744 \ubc1b\uc744 \uac83\n- \ubb3c\uac00 \uc0c1\uc2b9\uacfc \uad6d\ub0b4 \uc9c0\uc9c0\uc728 \ud558\ub77d\uc740 \uc911\uac04 \uc120\uac70\ub97c \uc55e\ub450\uace0 \ud2b8\ub7fc\ud504\ub97c \uc81c\ud55c\ud558\ub294 \uc694\uc778\n- \ud734\uc804\uc744 \uc704\ud55c \ud5a1\uc0c1 \uc9c4\ud589 \uc911. \ud2b8\ub7fc\ud504\uac00 \uc560\ucd08\uc5d0 \uc774\uc57c\uae30\ud588\ub358 4\uc8fc-6\uc8fc timeline\uc774 \uc77c\ub2e8 base-case\n- \uc77c\ubd80 \uc120\ubc15\ub4e4 \ud638\ub974\ubb34\uc988 \ud574\ud611 \uc131\uacf5\uc801 \ud1b5\uacfc. \uadf8\ub7ec\ub098 \uc804\ubc18\uc801\uc778 \ud56d\ud574\ub294 \uc774\ub8e8\uc5b4\uc9c0\uc9c0 \uc54a\uace0 \uc788\uc74c\n</code></pre>"},{"location":"theme/iran/#iran-conflict-tracker","title":"Iran Conflict Tracker","text":""},{"location":"theme/iran/#hormuz-passage-monitoring","title":"Hormuz Passage Monitoring","text":""},{"location":"theme/iran/#energy-prices","title":"Energy Prices","text":""},{"location":"theme/iran/#other-prices","title":"Other prices","text":""},{"location":"theme/iran/#politics","title":"Politics","text":""}]}